{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base": "#191724",
    "surface": "#1f1d2e",
    "overlay": "#26233a",
    "muted": "#6e6a86",
    "subtle": "#908caa",
    "text": "#e0def4",
    "gold": "#f6c177",
    "pine": "#31748f",
    "foam": "#9ccfd8",
    "highlightMed": "#403d52",
    "highlightHigh": "#524f67",
    "blueDeep": "#1e3a8a",
    "blueDark": "#1d4ed8",
    "blueText": "#3b82f6",

    "dawnBase": "#faf4ed",
    "dawnSurface": "#fffaf3",
    "dawnOverlay": "#f2e9e1",
    "dawnMuted": "#9893a5",
    "dawnSubtle": "#797593",
    "dawnText": "#575279",
    "dawnGold": "#ea9d34",
    "dawnPine": "#286983",
    "dawnFoam": "#56949f",
    "dawnHighlightMed": "#dfdad9",
    "dawnHighlightHigh": "#cecacd",
    "dawnBlueDeep": "#1e3a8a",
    "dawnBlueDark": "#1d4ed8",
    "dawnBlueText": "#2563eb",

    "gentleAdded": "#76946A",
    "gentleRemoved": "#C34043",
    "gentleAddedBg": "#3F4A2D",
    "gentleRemovedBg": "#5C3838",
    "gentleYellow": "#DCA561"
  },
  "theme": {
    "primary": { "dark": "blueDark", "light": "dawnBlueDark" },
    "secondary": { "dark": "blueDeep", "light": "dawnBlueDeep" },
    "accent": { "dark": "blueText", "light": "dawnBlueText" },
    "error": { "dark": "gentleRemoved", "light": "#C34043" },
    "warning": { "dark": "gentleYellow", "light": "dawnGold" },
    "success": { "dark": "foam", "light": "dawnFoam" },
    "info": { "dark": "pine", "light": "dawnPine" },

    "text": { "dark": "text", "light": "dawnText" },
    "textMuted": { "dark": "subtle", "light": "dawnSubtle" },
    "background": { "dark": "base", "light": "dawnBase" },
    "backgroundPanel": { "dark": "surface", "light": "dawnSurface" },
    "backgroundElement": { "dark": "overlay", "light": "dawnOverlay" },
    "border": { "dark": "blueDeep", "light": "dawnBlueDeep" },
    "borderActive": { "dark": "blueDark", "light": "dawnBlueDark" },
    "borderSubtle": { "dark": "highlightHigh", "light": "dawnHighlightHigh" },

    "diffAdded": "gentleAdded",
    "diffRemoved": "gentleRemoved",
    "diffContext": { "dark": "subtle", "light": "dawnSubtle" },
    "diffHunkHeader": { "dark": "muted", "light": "dawnMuted" },
    "diffHighlightAdded": "gentleAdded",
    "diffHighlightRemoved": "gentleRemoved",
    "diffAddedBg": { "dark": "gentleAddedBg", "light": "#e2e8d5" },
    "diffRemovedBg": { "dark": "gentleRemovedBg", "light": "#f2dede" },
    "diffContextBg": { "dark": "surface", "light": "dawnSurface" },
    "diffLineNumber": { "dark": "overlay", "light": "dawnOverlay" },
    "diffAddedLineNumberBg": { "dark": "gentleAddedBg", "light": "#e2e8d5" },
    "diffRemovedLineNumberBg": { "dark": "gentleRemovedBg", "light": "#f2dede" },

    "markdownText": { "dark": "text", "light": "dawnText" },
    "markdownHeading": { "dark": "blueText", "light": "dawnBlueText" },
    "markdownLink": { "dark": "foam", "light": "dawnFoam" },
    "markdownLinkText": { "dark": "blueText", "light": "dawnBlueText" },
    "markdownCode": { "dark": "gold", "light": "dawnGold" },
    "markdownBlockQuote": { "dark": "subtle", "light": "dawnSubtle" },
    "markdownEmph": { "dark": "blueText", "light": "dawnBlueText" },
    "markdownStrong": { "dark": "gentleYellow", "light": "dawnGold" },
    "markdownHorizontalRule": { "dark": "highlightHigh", "light": "dawnHighlightHigh" },
    "markdownListItem": { "dark": "blueDark", "light": "dawnBlueDark" },
    "markdownListEnumeration": { "dark": "blueDark", "light": "dawnBlueDark" },
    "markdownImage": { "dark": "foam", "light": "dawnFoam" },
    "markdownImageText": { "dark": "blueText", "light": "dawnBlueText" },
    "markdownCodeBlock": { "dark": "text", "light": "dawnText" },

    "syntaxComment": { "dark": "muted", "light": "dawnMuted" },
    "syntaxKeyword": { "dark": "pine", "light": "dawnPine" },
    "syntaxFunction": { "dark": "blueText", "light": "dawnBlueText" },
    "syntaxVariable": { "dark": "text", "light": "dawnText" },
    "syntaxString": { "dark": "gold", "light": "dawnGold" },
    "syntaxNumber": { "dark": "blueDark", "light": "dawnBlueDark" },
    "syntaxType": { "dark": "foam", "light": "dawnFoam" },
    "syntaxOperator": { "dark": "subtle", "light": "dawnSubtle" },
    "syntaxPunctuation": { "dark": "subtle", "light": "dawnSubtle" }
  }
}
