{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/jimscard/whiterabbit-neo:13b",
  "small_model": "ollama/whiterabbitneo:tools",
  "default_agent": "gentle-orchestrator",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 3000,
    "reserved": 10000
  },
  "permission": "allow",
  "provider": {
    "ollama": {
      "models": {
        "deepseek-r1:7b": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "DeepSeek R1 7B (reasoning)",
          "reasoning": true
        },
        "dolphin-mistral:latest": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Dolphin Mistral (uncensored)",
          "tool_call": true
        },
        "lazarevtill/Llama-3-WhiteRabbitNeo-8B-v2.0:q4_0": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "WhiteRabbitNeo 8B (Security)",
          "reasoning": false,
          "tool_call": true
        },
        "qwen2.5-coder:14b": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "Qwen2.5 Coder 14B (código, 50% CPU · ~5 tok/s)",
          "tool_call": true
        },
        "qwen3.5-32k:latest": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Qwen3.5 9B 32K (tools + thinking)",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3.5-4b-32k:latest": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Qwen3.5 4B 32K (rápido, 100% GPU)",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3.5:4b": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "Qwen3.5 4B (rápido, 100% GPU · 43 tok/s)",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3.5:9b": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "Qwen3.5 9B (mejor calidad, parte en CPU · lento)",
          "reasoning": true,
          "tool_call": true
        },
        "minimax-m3:cloud": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "MiniMax M3 (cloud)"
        },
        "dolphin-llama3:8b": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "Dolphin Llama3 8B (Uncensored)",
          "reasoning": false,
          "tool_call": true
        },
        "qwen2.5-coder:7b": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Qwen 2.5 Coder 7B",
          "reasoning": false,
          "tool_call": true
        },
        "whiterabbitneo:tools": {
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "name": "WhiteRabbitNeo 8B (Tools Enabled)",
          "reasoning": false,
          "tool_call": true
        },
        "jimscard/whiterabbit-neo:13b": {
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "name": "WhiteRabbitNeo 13B (analysis)",
          "reasoning": true,
          "tool_call": false
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": false
      }
    }
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "$HOME/.gentle-shell/runtime/engram-3.4.0/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
