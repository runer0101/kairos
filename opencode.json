{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "default_agent": "gentle-orchestrator",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 3000,
    "reserved": 10000
  },
  "permission": "allow",
  "disabled_providers": [
    "ollama"
  ],
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "$HOME/.gentle-shell/runtime/engram-3.4.0/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
