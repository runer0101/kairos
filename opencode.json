{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "venjix",
  "share": "disabled",
  "snapshot": true,
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 3000,
    "reserved": 10000
  },
  "disabled_providers": [
    "ollama"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.ssh/**": "deny",
      "$HOME/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "$HOME/.gnupg/**": "deny",
      "**/.aws/**": "deny",
      "$HOME/.aws/**": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/auth.json": "deny",
      "**/.env": "ask",
      "*.env": "ask",
      "**/.env.*": "ask",
      "**/.env.example": "allow",
      "**/*.pem": "ask",
      "**/.kube/config": "ask",
      "**/.docker/config.json": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "node --version": "allow",
      "pnpm --version": "allow",
      "git push*": "ask",
      "git commit*": "ask"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "venjix": {
      "description": "Perfil normal (por defecto): orquestador con DeepSeek v4.1 Flash y permisos normales",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "prompt": "{file:./prompts/orchestrator.md}",
      "color": "accent"
    },
    "venjix-auto": {
      "description": "Perfil automático: sin preguntas de permisos; la guarda de comandos destructivos sigue activa",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": "allow",
      "color": "warning"
    },
    "gentle-ai-explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "steps": 15
    },
    "jd-judge-b": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "{env:HOME}/.gentle-shell/runtime/engram-3.4.0/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
